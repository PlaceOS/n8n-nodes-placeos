{
    "name": "n8n-nodes-placeos",
    "version": "0.1.0",
    "description": "n8n nodes for PlaceOS: read and control systems, modules, zones and metadata, manage bookings and visitors, and trigger workflows when module status changes",
    "license": "MIT",
    "homepage": "https://github.com/PlaceOS/n8n-nodes-placeos#readme",
    "keywords": [
        "n8n-community-node-package",
        "n8n",
        "placeos",
        "smart-building",
        "workplace",
        "building-automation"
    ],
    "author": {
        "name": "PlaceOS",
        "email": "support@place.technology"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/PlaceOS/n8n-nodes-placeos.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc -p tsconfig.test.json"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/PlaceOsApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/PlaceOs/PlaceOs.node.js",
            "dist/nodes/PlaceOsTrigger/PlaceOsTrigger.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "0.53.3",
        "@types/node": "^24.19.2",
        "eslint": "9.32.0",
        "n8n-workflow": "2.44.2",
        "prettier": "3.6.2",
        "release-it": "^21.1.0",
        "typescript": "5.9.2",
        "vitest": "^5.0.5",
        "vitest-mock-extended": "^5.1.1"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    },
    "bugs": {
        "url": "https://github.com/PlaceOS/n8n-nodes-placeos/issues"
    },
    "engines": {
        "node": ">=22.4"
    }
}
