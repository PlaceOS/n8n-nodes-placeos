{
	"name": "PlaceOS: workplace assistant (AI Agent)",
	"nodes": [
		{
			"id": "b1d2e3f4-0000-4000-8000-000000000001",
			"name": "When chat message received",
			"type": "@n8n/n8n-nodes-langchain.chatTrigger",
			"typeVersion": 1.1,
			"position": [0, 0],
			"webhookId": "6f1f0a2e-5a3b-4e7c-9a1d-placeos-ai",
			"parameters": { "options": {} }
		},
		{
			"id": "b1d2e3f4-0000-4000-8000-000000000002",
			"name": "AI Agent",
			"type": "@n8n/n8n-nodes-langchain.agent",
			"typeVersion": 2.2,
			"position": [260, 0],
			"parameters": {
				"options": {
					"systemMessage": "You help staff with their workplace. Times are in the user's time zone; send them to tools as ISO 8601 with an offset. To find a free desk, use the free desks tool with the level's zone ID. For anything else in PlaceOS, call list_toolboxes, open the toolbox you need with open_toolbox, then run its tools with call_read_only or call_tool. Confirm with the user before changing or cancelling anything."
				}
			}
		},
		{
			"id": "b1d2e3f4-0000-4000-8000-000000000003",
			"name": "Chat model",
			"type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
			"typeVersion": 1.3,
			"position": [140, 220],
			"parameters": { "options": {} }
		},
		{
			"id": "b1d2e3f4-0000-4000-8000-000000000004",
			"name": "Free desks",
			"type": "n8n-nodes-placeos.placeOsTool",
			"typeVersion": 1,
			"position": [340, 220],
			"parameters": {
				"descriptionType": "manual",
				"toolDescription": "List the desks that are free on one level for a period. Needs the level's zone ID.",
				"resource": "desk",
				"operation": "getFree",
				"zone": {
					"__rl": true,
					"mode": "id",
					"value": "={{ $fromAI('level_zone_id', 'The zone ID of the level, starting with zone-', 'string') }}"
				},
				"returnAll": true,
				"filters": {
					"periodStart": "={{ $fromAI('period_start', 'Start of the period, ISO 8601 with offset', 'string') }}",
					"periodEnd": "={{ $fromAI('period_end', 'End of the period, ISO 8601 with offset', 'string') }}"
				}
			}
		},
		{
			"id": "b1d2e3f4-0000-4000-8000-000000000005",
			"name": "PlaceOS Staff API (MCP)",
			"type": "@n8n/n8n-nodes-langchain.mcpClientTool",
			"typeVersion": 1.2,
			"position": [540, 220],
			"parameters": {
				"endpointUrl": "https://placeos.example.com/api/staff/v1/mcp",
				"authentication": "headerAuth",
				"include": "all",
				"options": {}
			}
		}
	],
	"connections": {
		"When chat message received": { "main": [[{ "node": "AI Agent", "type": "main", "index": 0 }]] },
		"Chat model": { "ai_languageModel": [[{ "node": "AI Agent", "type": "ai_languageModel", "index": 0 }]] },
		"Free desks": { "ai_tool": [[{ "node": "AI Agent", "type": "ai_tool", "index": 0 }]] },
		"PlaceOS Staff API (MCP)": { "ai_tool": [[{ "node": "AI Agent", "type": "ai_tool", "index": 0 }]] }
	},
	"settings": { "executionOrder": "v1" }
}
